# Public site origin used for metadata and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery. Use an app password or a dedicated SMTP account.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=website@example.com
SMTP_PASS=replace-with-a-secret
CONTACT_RECEIVER_EMAIL=contact@example.com

# Optional remote asset delivery. Keep disabled when assets are served from /public.
NEXT_PUBLIC_USE_REMOTE_ASSETS=false
NEXT_PUBLIC_ASSET_BASE_URL=
NEXT_PUBLIC_IMAGE_CDN=
